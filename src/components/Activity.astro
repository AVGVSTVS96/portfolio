---
import activity from "../data/activity.json";
import { weeks as all } from "../lib/data";

const WEEKS = 52;
const HUES = 8;
const GAP = 3;

const digits = new Intl.NumberFormat("en-US");
const month = new Intl.DateTimeFormat("en-US", { month: "short", timeZone: "UTC" });
const short = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", timeZone: "UTC" });

const long = new Intl.DateTimeFormat("en-US", {
  weekday: "short",
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});

const medium = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });

const plural = (count: number, word: string) => (count === 1 ? word : `${word}s`);
const sum = (counts: number[]) => counts.reduce((a, b) => a + b, 0);

const weeks = all.slice(-WEEKS);
const half = WEEKS / 2;
const year = sum(weeks.flat().map(({ count }) => count));

const opens = (week: number) => weeks[week]?.some(({ date }) => date.endsWith("-01")) ?? false;

const months = (from: number, to: number) => {
  const starts = Array.from({ length: to - from }, (_, i) => from + i).filter((week) => week === from || opens(week));
  const room = (week: number) => Math.min(week, to - GAP);

  const kept = starts.filter((week, i) => {
    const next = starts[i + 1];
    const previous = starts[i - 1];

    return (week !== from || next === undefined || room(next) - week >= GAP) && (previous === undefined || room(week) - previous >= GAP);
  });

  return kept.map((week) => ({
    week,
    text: month.format(new Date(weeks[week]?.at(-1)?.date ?? "")),
    after: week > to - GAP ? to - 1 - week : undefined,
  }));
};

const wide = months(0, WEEKS);
const narrow = [...months(0, half), ...months(half, WEEKS)];

const days = activity.days.map((entry) => new Date(entry));
const daily: Record<string, number[]> = activity.daily;
const ranked = Object.entries(daily).map(([name, counts]) => ({ name, counts }));
const tail = ranked.slice(HUES);
const at = (counts: number[], i: number) => counts[i] ?? 0;

const series = [
  ...ranked.slice(0, HUES).map(({ name, counts }, hue) => ({ name, counts, hue: `var(--c${hue})`, kind: "project" })),
  { name: "private", counts: activity.private, hue: "var(--c-private)", kind: "private" },
  {
    name: "other",
    counts: days.map((_, i) => sum(tail.map(({ counts }) => at(counts, i)))),
    hue: "var(--c-other)",
    kind: "other",
  },
].filter(({ counts }) => sum(counts) > 0);

const totals = days.map((_, i) => sum(series.map(({ counts }) => at(counts, i))));
const peak = Math.max(...totals, 1);
const step = [1, 10, 100, 1000].flatMap((p) => [1, 2, 5].map((m) => m * p)).find((s) => s * 3 >= peak) ?? peak;
const grid = Array.from({ length: Math.floor(peak / step) }, (_, i) => (i + 1) * step);

const edges = new Map([
  [0, "start"],
  [days.length - 1, "end"],
]);

const ticks = new Map(
  days
    .map((day, i) => ({ day, i }))
    .filter(({ i }) => i === days.length - 1 || (i % 7 === 0 && i < days.length - 4))
    .map(({ day, i }, n, marks) => {
      const previous = marks[n - 1]?.day;
      const text = previous && month.format(previous) === month.format(day) ? String(day.getUTCDate()) : short.format(day);

      return [i, { text, edge: edges.get(i) }];
    }),
);

const others = (pick: (counts: number[]) => number) => {
  const shown = tail
    .map(({ name, counts }) => ({ name, count: pick(counts) }))
    .filter(({ count }) => count > 0)
    .toSorted((a, b) => b.count - a.count);

  const named = shown.slice(0, 3).map(({ name, count }) => `${name} ${digits.format(count)}`);

  return shown.length > 3 ? [...named, `${shown.length - 3} more`].join(" · ") : named.join(" · ");
};
---

<div class="activity">
  <figure>
    <figcaption><span class="dot">01</span><span class="label">Last 12 months</span></figcaption>
    <div
      class="screen"
      data-readout
      data-boot
      tabindex="0"
      aria-label="Contributions in the last 12 months. Arrow keys step through days."
    >
      <p class="readout" aria-live="polite">
        <span class="count dot lit" data-show="count" data-idle={digits.format(year)}>{digits.format(year)}</span>
        <span class="unit label" data-show="unit" data-idle="contributions">contributions</span>
        <span class="date label" data-show="date" data-idle=""></span>
        <span class="date label" data-show="day" data-idle=""></span>
      </p>
      <div class="calendar" style={`--weeks: ${WEEKS}; --half: ${half}`}>
        {
          [0, 1].map((band) => (
            <span class="weekdays" data-band={band}>
              <span />
              {["", "Mon", "", "Wed", "", "Fri", ""].map((day) => (
                <span class="label">{day}</span>
              ))}
            </span>
          ))
        }
        {
          weeks.map((week, index) => (
            <div class="week" style={`--i: ${index}; --band: ${Math.floor(index / half)}`}>
              <span class="month">
                {wide
                  .filter((mark) => mark.week === index)
                  .map(({ text, after }) => (
                    <span
                      class="label"
                      data-mode="wide"
                      data-end={after === undefined ? undefined : ""}
                      style={after === undefined ? undefined : `--after: ${after}`}
                    >
                      {text}
                    </span>
                  ))}
                {narrow
                  .filter((mark) => mark.week === index)
                  .map(({ text, after }) => (
                    <span
                      class="label"
                      data-mode="narrow"
                      data-end={after === undefined ? undefined : ""}
                      style={after === undefined ? undefined : `--after: ${after}`}
                    >
                      {text}
                    </span>
                  ))}
              </span>
              {week.map((entry) => (
                <span
                  class="cell"
                  data-level={entry.level}
                  data-tip
                  data-count={digits.format(entry.count)}
                  data-unit={plural(entry.count, "contribution")}
                  data-date={long.format(new Date(entry.date))}
                  data-day={medium.format(new Date(entry.date))}
                />
              ))}
            </div>
          ))
        }
      </div>
      <p class="key label" aria-hidden="true">
        Less{[0, 1, 2, 3, 4].map((level) => <span class="cell" data-level={level} />)}More
      </p>
    </div>
  </figure>

  <figure>
    <figcaption><span class="dot">02</span><span class="label">Last 30 days, by project</span></figcaption>
    <div
      class="screen"
      data-readout
      data-boot
      data-solo-root
      tabindex="0"
      aria-label="Contributions per project in the last 30 days. Arrow keys step through days."
    >
      <p class="readout" aria-live="polite">
        <span class="count dot lit" data-show="count" data-idle={digits.format(sum(totals))}
          >{digits.format(sum(totals))}</span
        >
        <span class="unit label" data-show="unit" data-idle="contributions">contributions</span>
        <span class="date label" data-show="date" data-idle=""></span>
        <span class="date label" data-show="day" data-idle=""></span>
      </p>
      <div class="plot" style={`--peak: ${peak}`}>
        {
          grid.map((value) => (
            <span class="rule" style={`--at: ${value / peak}`}>
              <span class="label">{digits.format(value)}</span>
            </span>
          ))
        }
        <div class="chart" style={`--days: ${days.length}`}>
          {
            days.map((entry, i) => (
              <span
                class="day"
                data-tip
                data-count={digits.format(at(totals, i))}
                data-unit={plural(at(totals, i), "contribution")}
                data-date={long.format(entry)}
                data-day={medium.format(entry)}
                data-others={others((counts) => at(counts, i))}
                {...Object.fromEntries(
                  series.map(({ counts }, s) => [`data-s${s}`, at(counts, i) ? digits.format(at(counts, i)) : ""]),
                )}
              >
                <span class="bar">
                  <span class="stack" style={`height: ${(at(totals, i) / peak) * 100}%`}>
                    {series.map(({ counts, hue, kind }, s) =>
                      at(counts, i) > 0 ? (
                        <span
                          class="seg"
                          data-kind={kind}
                          data-series={s}
                          style={`--hue: ${hue}; flex-grow: ${at(counts, i)}`}
                        />
                      ) : null,
                    )}
                  </span>
                </span>
                <span class="tick" data-edge={ticks.get(i)?.edge}>
                  {ticks.has(i) && <span class="label">{ticks.get(i)?.text}</span>}
                </span>
              </span>
            ))
          }
        </div>
      </div>
      <ul class="legend">
        {
          series.map(({ name, counts, hue, kind }, s) => (
            <li data-kind={kind} data-series={s} style={`--hue: ${hue}`}>
              <span class="swatch" />
              <span class="label name">{name}</span>
              <span class="label value" data-show={`s${s}`} data-idle={digits.format(sum(counts))}>
                {digits.format(sum(counts))}
              </span>
              {kind === "other" && (
                <span class="label members" data-show="others" data-idle={others(sum)}>
                  {others(sum)}
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </figure>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-solo-root]")) {
    const segs = root.querySelectorAll<HTMLElement>(".seg");

    const solo = (series?: string) => {
      for (const seg of segs) {
        seg.toggleAttribute("data-dim", series !== undefined && seg.dataset.series !== series);
      }
    };

    for (const item of root.querySelectorAll<HTMLElement>(".legend li")) {
      item.addEventListener("pointerenter", () => solo(item.dataset.series));
      item.addEventListener("pointerleave", () => solo());
    }
  }
</script>

<style>
  .activity {
    --c0: #5b9cf5;
    --c1: #f07a45;
    --c2: #a08cf2;
    --c3: #e8b23a;
    --c4: #e47fb5;
    --c5: #8fcf4f;
    --c6: #6fd3f0;
    --c7: #ef5f5f;
    --c-other: color-mix(in oklab, var(--ink) 30%, var(--screen));
    --c-private: repeating-linear-gradient(
      -45deg,
      color-mix(in oklab, var(--ink) 55%, var(--screen)) 0 1.5px,
      transparent 1.5px 4px
    );
    --gutter: 28px;

    display: grid;
    gap: 56px;
  }

  :root[data-finish="silver"] .activity {
    --c0: #1f5fc8;
    --c1: #b8420c;
    --c2: #6440c8;
    --c3: #8a5f00;
    --c4: #b0307a;
    --c5: #3f7208;
    --c6: #00709f;
    --c7: #b3201f;
    --c-other: color-mix(in oklab, var(--ink) 22%, var(--screen));
    --c-private: repeating-linear-gradient(
      -45deg,
      color-mix(in oklab, var(--ink) 70%, var(--screen)) 0 1.5px,
      transparent 1.5px 4px
    );
  }

  figure {
    margin: 0;
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  figcaption .dot {
    font-size: 11px;
    color: var(--ink-3);
  }

  figcaption .label {
    color: var(--ink-2);
  }

  figcaption::after {
    flex: 1;
    height: 1px;
    content: "";
    background: var(--line);
  }

  .screen {
    padding: 20px;
    container-type: inline-size;
    touch-action: pan-y;
  }

  .label {
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.1em;
    white-space: nowrap;
    color: var(--seg);
  }

  .readout {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 20px;
  }

  .count {
    font-size: 32px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .unit {
    opacity: 0.6;
  }

  .date {
    margin-left: auto;
    font-size: 11px;
    transition: opacity 160ms var(--ease-out);
  }

  .date[data-show="day"] {
    display: none;
  }

  .date:empty {
    opacity: 0;
  }

  .calendar {
    display: grid;
    --gap: clamp(2px, 0.5cqi, 3px);

    grid-template-columns: calc(var(--gutter) - var(--gap)) repeat(var(--weeks), 1fr);
    grid-template-rows: 18px repeat(7, auto);
    gap: var(--gap);
  }

  .weekdays,
  .week {
    display: grid;
    grid-row: 1 / span 8;
    grid-template-rows: subgrid;
  }

  .weekdays {
    grid-column: 1;
  }

  .weekdays .label {
    display: flex;
    align-items: center;
    height: 0;
    align-self: center;
    font-size: 9px;
    opacity: 0.5;
  }

  .weekdays[data-band="1"] {
    display: none;
  }

  .week {
    grid-column: calc(var(--i) + 2);
  }

  .month {
    position: relative;
  }

  .month .label {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0.7;
  }

  .month [data-end] {
    right: calc(var(--after) * -1 * (100% + var(--gap)));
    left: auto;
  }

  .month [data-mode="narrow"] {
    display: none;
  }

  .cell {
    position: relative;
    aspect-ratio: 1;
    border-radius: clamp(1px, 0.3cqi, 2px);
    background: color-mix(in oklab, var(--seg) calc(var(--glow, 0.1) * 100%), var(--seg-off));
    outline: 1.5px solid transparent;
    outline-offset: 1px;
    transition: outline-color 120ms;
  }

  .week .cell::after {
    position: absolute;
    inset: calc(var(--gap) / -2);
    content: "";
  }

  .cell[data-picked] {
    outline-color: var(--ink);
  }

  .cell[data-level="0"] {
    --glow: 0.04;
  }

  .cell[data-level="1"] {
    --glow: 0.36;
  }

  .cell[data-level="2"] {
    --glow: 0.55;
  }

  .cell[data-level="3"] {
    --glow: 0.78;
  }

  .cell[data-level="4"] {
    --glow: 1;

    box-shadow: var(--seg-glow);
  }

  :root[data-finish="silver"] .cell[data-level="0"] {
    --glow: 0.05;
  }

  .key {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 3px;
    margin: 14px 0 0;
    font-size: 9px;
    opacity: 0.7;
  }

  .key .cell {
    width: 9px;
  }

  .key .cell:first-child {
    margin-left: 5px;
  }

  .key .cell:last-child {
    margin-right: 5px;
  }

  .plot {
    position: relative;
    --height: clamp(120px, 26cqi, 168px);

    padding-left: var(--gutter);
  }

  .rule {
    position: absolute;
    right: 0;
    bottom: calc(22px + var(--at) * var(--height));
    left: var(--gutter);
    border-top: 1px dashed color-mix(in oklab, var(--seg) 14%, transparent);
  }

  .rule .label {
    position: absolute;
    left: calc(var(--gutter) * -1);
    translate: 0 -50%;
    font-size: 9px;
    opacity: 0.5;
  }

  .chart {
    display: grid;
    --gap: clamp(2px, 1cqi, 6px);

    grid-template-columns: repeat(var(--days), 1fr);
    margin-inline: calc(var(--gap) / -2);
  }

  .day {
    display: grid;
    grid-template-rows: var(--height) 22px;
    padding-inline: calc(var(--gap) / 2);
  }

  .bar {
    display: flex;
    align-items: end;
    background: linear-gradient(var(--seg-off), var(--seg-off)) bottom / 100% 1px no-repeat;
  }

  .stack {
    display: flex;
    flex-direction: column-reverse;
    gap: 1px;
    width: 100%;
    border-radius: 2px 2px 0 0;
    outline: 1.5px solid transparent;
    outline-offset: 1.5px;
    transition: outline-color 120ms;
  }

  .day[data-picked] .stack {
    min-height: 2px;
    outline-color: var(--ink);
  }

  .seg {
    flex-basis: 0;
    min-height: 1px;
    background: var(--hue);
    transition: opacity 140ms;
  }

  .seg:last-child {
    border-radius: 2px 2px 0 0;
  }

  .seg[data-dim] {
    opacity: 0.18;
  }

  :global(:root:not([data-finish="silver"])) .seg[data-kind="project"] {
    box-shadow: 0 0 6px color-mix(in srgb, var(--hue) 35%, transparent);
  }

  .tick {
    position: relative;
  }

  .tick .label {
    position: absolute;
    top: 9px;
    left: 50%;
    translate: -50%;
    opacity: 0.7;
  }

  .tick[data-edge="start"] .label {
    left: 0;
    translate: 0;
  }

  .tick[data-edge="end"] .label {
    right: 0;
    left: auto;
    translate: 0;
  }

  .legend {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(124px, 1fr));
    align-items: start;
    gap: 10px 24px;
    margin: 18px 0 0;
    padding: 16px 0 0;
    border-top: 1px solid color-mix(in oklab, var(--seg) 10%, transparent);
    list-style: none;
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    cursor: default;
    transition: opacity 140ms;
  }

  .legend li[data-kind="private"] {
    grid-column: 1;
  }

  .legend li[data-kind="other"] {
    flex-wrap: wrap;
    grid-column: 2 / -1;
    row-gap: 8px;
  }

  .swatch {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--hue);
  }

  .legend .name {
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0.75;
  }

  .legend .value {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }

  li[data-kind="other"] .value {
    margin-left: 0;
  }

  .value:empty::before {
    content: "–";
  }

  .legend li:has(.value:empty) {
    opacity: 0.4;
  }

  .members {
    flex-basis: 100%;
    min-height: 1lh;
    padding-left: 16px;
    line-height: 1.5;
    white-space: normal;
    opacity: 0.5;
  }

  @container (width < 480px) {
    .calendar {
      grid-template-columns: calc(var(--gutter) - var(--gap)) repeat(var(--half), 1fr);
      grid-template-rows: 18px repeat(7, auto) 10px 18px repeat(7, auto);
    }

    .weekdays[data-band="1"] {
      display: grid;
      grid-row: 10 / span 8;
    }

    .week {
      grid-row: calc(var(--band) * 9 + 1) / span 8;
      grid-column: calc(var(--i) - var(--band) * var(--half) + 2);
    }

    .month [data-mode="wide"] {
      display: none;
    }

    .month [data-mode="narrow"] {
      display: block;
    }

    .count {
      font-size: 28px;
    }

    .legend {
      grid-template-columns: 1fr 1fr;
      column-gap: 18px;
    }

    .legend li[data-kind="other"] {
      grid-column: 1 / -1;
    }

    .legend .label {
      letter-spacing: 0.05em;
    }

    .date[data-show="date"] {
      display: none;
    }

    .date[data-show="day"] {
      display: block;
    }
  }

  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .readout,
    .week,
    .day,
    .rule,
    .key,
    .legend {
      animation: fade 420ms var(--ease-out) backwards paused;
    }

    .week {
      animation-delay: calc(sibling-index() * 8ms);
    }

    .day {
      animation-delay: calc(sibling-index() * 14ms);
    }

    .key,
    .legend {
      animation-delay: 420ms;
    }

    .screen[data-on] :is(.readout, .week, .day, .rule, .key, .legend) {
      animation-play-state: running;
    }
  }
</style>
