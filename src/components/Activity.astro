---
import activity from "../data/activity.json";
import { contributions, weeks } from "../lib/data";

const HUES = 7;

const format = new Intl.NumberFormat("en-US");
const digits = new Intl.NumberFormat("en-US", { useGrouping: false });
const month = new Intl.DateTimeFormat("en-US", { month: "short", timeZone: "UTC" });
const short = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
const long = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });

const plural = (count: number, word: string) => (count === 1 ? word : `${word}s`);
const sum = (counts: number[]) => counts.reduce((a, b) => a + b, 0);

const total = digits.format(contributions.total.lastYear);
const padding = 7 - (weeks[0]?.length ?? 7);
const half = Math.ceil(weeks.length / 2);

const last = (week: number) => new Date(weeks[week]?.at(-1)?.date ?? "");
const startsMonth = (week: number) => last(week).getUTCDate() <= 7;

const LABEL = 3;

const bandLabels = (first: number, end: number, mode: string) => {
  const kept: number[] = [];

  const stop = end === weeks.length ? end : end - LABEL + 1;

  for (let week = first; week < stop; week += 1) {
    const previous = kept.at(-1);

    if (week !== first && !startsMonth(week)) {
      continue;
    }

    if (previous === undefined || Math.min(week, end - LABEL) >= previous + LABEL) {
      kept.push(week);
    } else if (previous === first && !startsMonth(first)) {
      kept[kept.length - 1] = week;
    }
  }

  return kept.map((week) => ({ week, mode, after: week > end - LABEL ? end - 1 - week : undefined }));
};

const labels = [
  ...bandLabels(0, weeks.length, "wide"),
  ...bandLabels(0, half, "narrow"),
  ...bandLabels(half, weeks.length, "narrow"),
];

const days = activity.days.map((entry) => new Date(entry));

const ranked = Object.entries(activity.repos)
  .map(([id, { daily }]) => ({ id, daily, total: sum(daily) }))
  .filter(({ total: commits }) => commits > 0)
  .toSorted((a, b) => b.total - a.total);

const fold = ranked.length > HUES;
const projects = fold ? ranked.slice(0, HUES) : ranked;
const tail = fold ? ranked.slice(HUES) : [];
const rest = days.map((_, i) => sum(tail.map(({ daily }) => daily[i] ?? 0)));

const totals = days.map((_, i) => sum(ranked.map(({ daily }) => daily[i] ?? 0)));
const peak = Math.max(...totals, 1);
const commits = sum(totals);

const ticks = new Set(days.map((_, i) => i).filter((i) => i === 0 || (i >= 3 && (days.length - 1 - i) % 7 === 0)));
---

<div class="activity">
  <figure>
    <figcaption><span class="dot">01</span><span class="label">Last 12 months</span></figcaption>
    <div
      class="screen"
      data-readout
      data-link="activity"
      data-boot
      tabindex="0"
      aria-label="Contributions in the last 12 months. Arrow keys step through days."
    >
      <p class="readout" aria-live="polite">
        <span class="count dot lit" data-show="count" data-idle={total}>{total}</span>
        <span class="unit label" data-show="unit" data-idle="contributions">contributions</span>
        <span class="date dot lit" data-show="date" data-idle=""></span>
      </p>
      <div class="calendar" style={`--weeks: ${weeks.length}; --half: ${half}`}>
        {
          weeks.map((week, index) => (
            <div class="week">
              <span class="month">
                {labels
                  .filter((mark) => mark.week === index)
                  .map(({ mode, after }) => (
                    <span
                      class="label"
                      data-mode={mode}
                      data-end={after === undefined ? undefined : ""}
                      style={after === undefined ? undefined : `--after: ${after}`}
                    >
                      {month.format(last(index))}
                    </span>
                  ))}
              </span>
              {index === 0 && Array.from({ length: padding }, () => <span />)}
              {week.map((entry) => (
                <span
                  class="cell"
                  data-level={entry.level}
                  data-tip
                  data-day={entry.date}
                  data-count={digits.format(entry.count)}
                  data-unit={plural(entry.count, "contribution")}
                  data-date={long.format(new Date(entry.date))}
                />
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </figure>

  <figure>
    <figcaption><span class="dot">02</span><span class="label">Last 30 days, by project</span></figcaption>
    <div
      class="screen"
      data-readout
      data-link="activity"
      data-boot
      tabindex="0"
      aria-label="Commits per project in the last 30 days. Arrow keys step through days."
    >
      <p class="readout" aria-live="polite">
        <span class="count dot lit" data-show="count" data-idle={digits.format(commits)}>{digits.format(commits)}</span>
        <span class="unit label" data-show="unit" data-idle="commits">commits</span>
        <span class="date dot lit" data-show="date" data-idle=""></span>
      </p>
      <div class="chart" style={`--days: ${days.length}`}>
        {
          days.map((entry, i) => (
            <span
              class="day"
              data-tip
              data-day={activity.days[i]}
              data-count={digits.format(totals[i] ?? 0)}
              data-unit={plural(totals[i] ?? 0, "commit")}
              data-date={long.format(entry)}
              data-rest={rest[i] ? format.format(rest[i]) : ""}
              {...Object.fromEntries(projects.map(({ daily }, p) => [`data-p${p}`, daily[i] ? format.format(daily[i]) : ""]))}
            >
              <span class="bar">
                {(totals[i] ?? 0) > 0 && (
                  <span class="fill" style={`height: ${((totals[i] ?? 0) / peak) * 100}%`}>
                    {projects.map(({ daily }, p) =>
                      daily[i] ? <span class="seg" data-project={p} data-hue={p} style={`flex-grow: ${daily[i]}`} /> : null,
                    )}
                    {(rest[i] ?? 0) > 0 && (
                      <span class="seg" data-project="rest" data-hue="rest" style={`flex-grow: ${rest[i]}`} />
                    )}
                  </span>
                )}
              </span>
              <span class="tick">{ticks.has(i) && <span class="label">{short.format(entry)}</span>}</span>
            </span>
          ))
        }
      </div>
      <ul class="legend">
        {
          projects.map(({ id, total: count }, p) => (
            <li data-hue={p}>
              <button type="button" data-solo={p} aria-pressed="false">
                <span class="swatch" />
                <span class="label name">{id}</span>
                <span class="label value" data-show={`p${p}`} data-idle={format.format(count)}>
                  {format.format(count)}
                </span>
              </button>
            </li>
          ))
        }
        {
          tail.length > 0 && (
            <li class="others" data-hue="rest">
              <button type="button" data-solo="rest" aria-pressed="false">
                <span class="swatch" />
                <span class="label name">
                  {tail.map(({ id }, i) => (
                    <>
                      {i > 0 && ", "}
                      <span class="nowrap">{id}</span>
                    </>
                  ))}
                </span>
                <span class="label value" data-show="rest" data-idle={format.format(sum(rest))}>
                  {format.format(sum(rest))}
                </span>
              </button>
            </li>
          )
        }
      </ul>
    </div>
  </figure>
</div>

<script>
  const at = (event: Event) =>
    event.target instanceof Element ? event.target.closest<HTMLElement>("[data-solo]")?.dataset.solo : undefined;

  const wire = (legend: HTMLElement) => {
    const chart = legend.previousElementSibling;
    const buttons = legend.querySelectorAll<HTMLButtonElement>("[data-solo]");
    let pinned: string | undefined;

    const solo = (project?: string) => {
      for (const target of [legend, chart]) {
        target?.toggleAttribute("data-solo", project !== undefined);
      }

      for (const seg of chart?.querySelectorAll<HTMLElement>(".seg") ?? []) {
        seg.toggleAttribute("data-on", seg.dataset.project === project);
      }

      for (const button of buttons) {
        button.ariaPressed = String(button.dataset.solo === project);
      }
    };

    legend.addEventListener("click", (event) => {
      const project = at(event);
      pinned = pinned === project ? undefined : project;
      solo(pinned);
    });

    legend.addEventListener("pointerover", (event) => {
      if (event.pointerType === "mouse") {
        solo(at(event) ?? pinned);
      }
    });

    legend.addEventListener("pointerleave", (event) => {
      if (event.pointerType === "mouse") {
        solo(pinned);
      }
    });
  };

  for (const legend of document.querySelectorAll<HTMLElement>(".legend")) {
    wire(legend);
  }
</script>

<style>
  .activity {
    --h0: #3fd9b8;
    --h1: #f0a030;
    --h2: #7b93ff;
    --h3: #ff7356;
    --h4: #b386f5;
    --h5: #bcd04a;
    --h6: #f27aa2;
    --h-rest: #59605d;
    --stub: color-mix(in oklab, var(--seg) 22%, transparent);

    display: grid;
    gap: 48px;
  }

  :root[data-finish="silver"] .activity {
    --h0: #00806a;
    --h1: #a65a00;
    --h2: #3552c4;
    --h3: #c63b2b;
    --h4: #8040c8;
    --h5: #4f7400;
    --h6: #c02f6e;
    --h-rest: #6c7468;
  }

  figure {
    margin: 0;
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  figcaption .dot {
    font-size: 11px;
    color: var(--ink-3);
  }

  figcaption .label {
    color: var(--ink-2);
  }

  figcaption::after {
    flex: 1;
    height: 1px;
    content: "";
    background: var(--line);
  }

  .screen {
    padding: 18px 20px 20px;
    container-type: inline-size;
    touch-action: pan-y;
  }

  .readout {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 18px;
  }

  .count {
    font-size: 32px;
    line-height: 1;
    font-feature-settings: "palt";
  }

  .unit {
    color: var(--seg);
    opacity: 0.6;
  }

  .date {
    margin-left: auto;
    font-size: 16px;
    line-height: 1;
    white-space: nowrap;
    font-feature-settings: "palt";
  }

  .calendar {
    display: grid;
    --gap: clamp(1.5px, 0.5cqi, 3px);

    grid-template-columns: repeat(var(--weeks), 1fr);
    gap: var(--gap);
  }

  .week {
    display: grid;
    gap: var(--gap);
    align-content: start;
  }

  .month {
    position: relative;
    height: 16px;
  }

  .month .label {
    position: absolute;
    top: 0;
    left: 0;
    font-size: 9.5px;
    line-height: 1;
    letter-spacing: 0.1em;
    white-space: nowrap;
    color: var(--seg);
    opacity: 0.55;
  }

  .month [data-end] {
    right: calc(var(--after) * -1 * (100% + var(--gap)));
    left: auto;
  }

  .month [data-mode="narrow"] {
    display: none;
  }

  .week > span:not(.month) {
    aspect-ratio: 1;
  }

  .cell {
    position: relative;
    border-radius: clamp(1px, 0.3cqi, 2px);
    background: color-mix(in oklab, var(--seg) calc(var(--glow, 0) * 100%), var(--seg-off));
  }

  .cell::after {
    position: absolute;
    inset: calc(var(--gap) / -2);
    content: "";
  }

  .cell[data-level="1"] {
    --glow: 0.3;
  }

  .cell[data-level="2"] {
    --glow: 0.52;
  }

  .cell[data-level="3"] {
    --glow: 0.75;
  }

  .cell[data-level="4"] {
    --glow: 1;

    box-shadow: var(--seg-glow);
  }

  .cell,
  .bar {
    outline: 1.5px solid transparent;
    outline-offset: 1px;
    transition: outline-color 120ms;
  }

  .cell[data-picked],
  .day[data-picked] .bar {
    outline-color: var(--ink);
  }

  .chart {
    display: grid;
    --gap: clamp(2px, 1.1cqi, 7px);

    grid-template-columns: repeat(var(--days), 1fr);
  }

  .day {
    display: grid;
    grid-template-rows: clamp(96px, 22cqi, 140px) 22px;
    padding-inline: calc(var(--gap) / 2);
  }

  .bar {
    display: flex;
    align-items: end;
    border-radius: 2px;
    background: linear-gradient(var(--stub), var(--stub)) bottom / 100% 2px no-repeat;
  }

  .fill {
    display: flex;
    flex-direction: column-reverse;
    gap: 1px;
    width: 100%;
    min-height: 2px;
    overflow: hidden;
    border-radius: 2px;
  }

  .seg {
    flex-basis: 0;
    min-height: 1px;
    background: var(--hue);
    transition: background-color 140ms;
  }

  :global(:root:not([data-finish="silver"])) .seg {
    box-shadow: 0 0 6px color-mix(in srgb, var(--hue) 35%, transparent);
  }

  .chart[data-solo] .seg:not([data-on]) {
    background: var(--stub);
    box-shadow: none;
  }

  .chart[data-solo] [data-hue="rest"][data-on],
  .others [aria-pressed="true"] {
    --hue: var(--ink-2);
  }

  [data-hue="0"] {
    --hue: var(--h0);
  }

  [data-hue="1"] {
    --hue: var(--h1);
  }

  [data-hue="2"] {
    --hue: var(--h2);
  }

  [data-hue="3"] {
    --hue: var(--h3);
  }

  [data-hue="4"] {
    --hue: var(--h4);
  }

  [data-hue="5"] {
    --hue: var(--h5);
  }

  [data-hue="6"] {
    --hue: var(--h6);
  }

  [data-hue="rest"] {
    --hue: var(--h-rest);
  }

  .tick {
    position: relative;
  }

  .tick .label {
    position: absolute;
    top: 8px;
    left: 50%;
    translate: -50%;
    font-size: 9.5px;
    line-height: 1;
    letter-spacing: 0.1em;
    white-space: nowrap;
    color: var(--seg);
    opacity: 0.55;
  }

  .day:first-child .tick .label {
    left: calc(var(--gap) / 2);
    translate: none;
  }

  .day:last-child .tick .label {
    right: calc(var(--gap) / 2 - 0.1em);
    left: auto;
    translate: none;
  }

  .legend {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(128px, 1fr));
    gap: 0 24px;
    margin: 14px 0 0;
    padding: 10px 0 0;
    border-top: 1px solid var(--seg-off);
    list-style: none;
  }

  .others {
    grid-column: 1 / -1;
  }

  .nowrap {
    white-space: nowrap;
  }

  .legend button {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    min-width: 0;
    padding: 6px 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: opacity 140ms;
  }

  .swatch {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--hue);
  }

  .legend .label {
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--seg);
  }

  .name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 0.75;
  }

  .value {
    flex: none;
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }

  .value:empty::before {
    content: "–";
  }

  .legend button:has(.value:empty),
  .legend[data-solo] button:not([aria-pressed="true"]) {
    opacity: 0.4;
  }

  @container (width < 420px) {
    .calendar {
      grid-template-columns: repeat(var(--half), 1fr);
      row-gap: 14px;
    }

    .month [data-mode="wide"] {
      display: none;
    }

    .month [data-mode="narrow"] {
      display: block;
    }

    .count {
      font-size: 28px;
    }

    .date {
      font-size: 14px;
    }

    .legend {
      grid-template-columns: 1fr 1fr;
      column-gap: 16px;
    }

    .legend button {
      padding: 5px 0;
    }

    .others .name {
      white-space: normal;
    }
  }

  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .readout,
    .week,
    .day,
    .legend {
      animation: fade 420ms var(--ease-out) backwards paused;
    }

    .week {
      animation-delay: calc(sibling-index() * 8ms);
    }

    .day {
      animation-delay: calc(sibling-index() * 14ms);
    }

    .legend {
      animation-delay: 420ms;
    }

    .screen[data-on] :is(.readout, .week, .day, .legend) {
      animation-play-state: running;
    }
  }
</style>
