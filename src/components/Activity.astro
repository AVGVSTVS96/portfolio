---
import activity from "../data/activity.json";
import { contributions, weeks } from "../lib/data";

const COLORED = 4;

const format = new Intl.NumberFormat("en-US");
const month = new Intl.DateTimeFormat("en-US", { month: "short", timeZone: "UTC" });
const short = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
const long = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });

const plural = (count: number, word: string) => (count === 1 ? word : `${word}s`);

const total = format.format(contributions.total.lastYear);
const padding = 7 - (weeks[0]?.length ?? 7);

const half = Math.ceil(weeks.length / 2);
const date = (week: number, at: number) => new Date(weeks[week]?.at(at)?.date ?? "");
const startsMonth = (week: number) => date(week, -1).getUTCDate() <= 7;

const labelled = (week: number, first: number, end: number) =>
  week <= end - 4 && (startsMonth(week) || (week === first && !startsMonth(week + 1) && !startsMonth(week + 2)));

const columns = weeks.map((week, index) => {
  const first = index < half ? 0 : half;

  return {
    week,
    label: month.format(date(index, startsMonth(index) ? -1 : 0)),
    wide: labelled(index, 0, weeks.length),
    narrow: labelled(index, first, first === 0 ? half : weeks.length),
  };
});

const days = activity.days.map((entry) => new Date(entry));
const sum = (counts: number[]) => counts.reduce((a, b) => a + b, 0);

const ranked = Object.entries(activity.repos)
  .map(([id, { daily }]) => ({ id, daily, total: sum(daily) }))
  .filter(({ total: commits }) => commits > 0)
  .toSorted((a, b) => b.total - a.total);

const rest = ranked.slice(COLORED);

const series = [
  ...ranked.slice(0, COLORED),
  ...(rest.length > 0
    ? [{ id: `${rest.length} more`, daily: days.map((_, i) => sum(rest.map(({ daily }) => daily[i] ?? 0))), total: sum(rest.map((r) => r.total)) }]
    : []),
];

const totals = days.map((_, i) => sum(series.map(({ daily }) => daily[i] ?? 0)));
const peak = Math.max(...totals);
const commits = sum(totals);

const ticks = new Set(days.map((_, i) => i).filter((i) => (days.length - 1 - i) % 7 === 0));
---

<div class="activity">
  <figure>
    <figcaption><span class="dot">01</span><span class="label">Last 12 months</span></figcaption>
    <div class="screen" data-readout data-boot>
      <p class="readout">
        <span class="count dot lit" data-show="count" data-idle={total}>{total}</span>
        <span class="unit label" data-show="unit" data-idle="contributions">contributions</span>
        <span class="date dot lit" data-show="date" data-idle=""></span>
      </p>
      <div class="calendar" style={`--weeks: ${weeks.length}; --half: ${half}`}>
        {
          columns.map(({ week, label, wide, narrow }, index) => (
            <div class="week">
              <span class="month label" data-wide={wide ? "" : undefined} data-narrow={narrow ? "" : undefined}>
                {wide || narrow ? label : ""}
              </span>
              {index === 0 && Array.from({ length: padding }, () => <span />)}
              {week.map((entry) => (
                <span
                  class="cell"
                  data-level={entry.level}
                  data-tip
                  data-count={format.format(entry.count)}
                  data-unit={plural(entry.count, "contribution")}
                  data-date={long.format(new Date(entry.date))}
                />
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </figure>

  <figure>
    <figcaption><span class="dot">02</span><span class="label">Last 30 days, by project</span></figcaption>
    <div class="screen" data-readout data-boot>
      <p class="readout">
        <span class="count dot lit" data-show="count" data-idle={format.format(commits)}>{format.format(commits)}</span>
        <span class="unit label" data-show="unit" data-idle="commits">commits</span>
        <span class="date dot lit" data-show="date" data-idle=""></span>
      </p>
      <div class="chart" style={`--days: ${days.length}`}>
        {
          days.map((entry, i) => (
            <span
              class="day"
              data-tip
              data-count={format.format(totals[i] ?? 0)}
              data-unit={plural(totals[i] ?? 0, "commit")}
              data-date={short.format(entry)}
              {...Object.fromEntries(series.map(({ daily }, s) => [`data-s${s}`, format.format(daily[i] ?? 0)]))}
            >
              <span class="bar">
                <span class="fill" style={`height: ${((totals[i] ?? 0) / peak) * 100}%`}>
                  {series.map(({ daily }, s) =>
                    daily[i] ? <span class="seg" data-series={s} style={`flex-grow: ${daily[i]}`} /> : null,
                  )}
                </span>
              </span>
              <span class="tick">{ticks.has(i) && <span class="label">{short.format(entry)}</span>}</span>
            </span>
          ))
        }
      </div>
      <ul class="legend">
        {
          series.map(({ id, total: count }, s) => (
            <li data-series={s}>
              <span class="swatch" />
              <span class="label name">{id}</span>
              <span class="label value" data-show={`s${s}`} data-idle={format.format(count)}>
                {format.format(count)}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </figure>
</div>

<style>
  .activity {
    --s0: #5cf2d0;
    --s1: #ffb347;
    --s2: #ff6b8b;
    --s3: #82a8ff;
    --s4: #56625e;

    display: grid;
    gap: 44px;
  }

  :root[data-finish="silver"] .activity {
    --s0: #1a8a72;
    --s1: #b5740f;
    --s2: #c0365a;
    --s3: #3a64c4;
    --s4: #8b9187;
  }

  figure {
    margin: 0;
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  figcaption .dot {
    font-size: 11px;
    color: var(--ink-3);
  }

  figcaption .label {
    color: var(--ink-2);
  }

  figcaption::after {
    flex: 1;
    height: 1px;
    content: "";
    background: var(--line);
  }

  .screen {
    padding: 18px 20px 20px;
    container-type: inline-size;
  }

  .readout {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 18px;
  }

  .count {
    font-size: 32px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .unit {
    color: var(--seg);
    opacity: 0.6;
  }

  .date {
    margin-left: auto;
    font-size: 16px;
    line-height: 1;
    white-space: nowrap;
  }

  .calendar {
    display: grid;
    --gap: clamp(1.5px, 0.5cqi, 3px);

    grid-template-columns: repeat(var(--weeks), 1fr);
    gap: var(--gap);
    touch-action: pan-y;
  }

  .week {
    display: grid;
    gap: var(--gap);
    align-content: start;
  }

  .month {
    height: 16px;
    width: 0;
    overflow: visible;
    font-size: 9px;
    letter-spacing: 0.1em;
    white-space: nowrap;
    color: var(--seg);
    opacity: 0.45;
  }

  .month:not([data-wide]) {
    visibility: hidden;
  }

  .week > span:not(.month) {
    aspect-ratio: 1;
  }

  .cell {
    border-radius: clamp(1px, 0.3cqi, 2px);
    background: color-mix(in oklab, var(--seg) calc(var(--glow, 0) * 100%), var(--seg-off));
  }

  .cell[data-level="1"] {
    --glow: 0.3;
  }

  .cell[data-level="2"] {
    --glow: 0.52;
  }

  .cell[data-level="3"] {
    --glow: 0.75;
  }

  .cell[data-level="4"] {
    --glow: 1;

    box-shadow: var(--seg-glow);
  }

  .cell[data-picked] {
    outline: 1px solid var(--seg);
    outline-offset: 1.5px;
  }

  .chart {
    display: grid;
    grid-template-columns: repeat(var(--days), 1fr);
    gap: clamp(2px, 0.6cqi, 4px);
    touch-action: pan-y;
  }

  .day {
    display: grid;
    grid-template-rows: clamp(96px, 22cqi, 128px) 22px;
    transition: opacity 140ms;
  }

  .chart:has([data-picked]) .day:not([data-picked]) {
    opacity: 0.35;
  }

  .bar {
    display: flex;
    align-items: end;
    border-radius: 2px;
    background: var(--seg-off);
  }

  .fill {
    display: flex;
    flex-direction: column-reverse;
    gap: 2px;
    width: 100%;
  }

  .seg {
    flex-basis: 0;
    min-height: 2px;
    background: var(--color);
  }

  .seg:first-child {
    border-radius: 0 0 2px 2px;
  }

  .seg:last-child {
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
  }

  :global(:root:not([data-finish="silver"])) .seg {
    box-shadow: 0 0 6px color-mix(in srgb, var(--color) 45%, transparent);
  }

  [data-series="0"] {
    --color: var(--s0);
  }

  [data-series="1"] {
    --color: var(--s1);
  }

  [data-series="2"] {
    --color: var(--s2);
  }

  [data-series="3"] {
    --color: var(--s3);
  }

  [data-series="4"] {
    --color: var(--s4);
  }

  .tick {
    position: relative;
  }

  .tick .label {
    position: absolute;
    top: 8px;
    left: 50%;
    translate: -50%;
    font-size: 9px;
    letter-spacing: 0.1em;
    white-space: nowrap;
    color: var(--seg);
    opacity: 0.45;
  }

  .day:last-child .tick .label {
    right: 0;
    left: auto;
    translate: none;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin: 14px 0 0;
    padding: 14px 0 0;
    border-top: 1px solid var(--seg-off);
    list-style: none;
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: 8px;
    transition: opacity 140ms;
  }

  .swatch {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--color);
  }

  .legend .label {
    font-size: 9.5px;
    letter-spacing: 0.1em;
    color: var(--seg);
  }

  .name {
    opacity: 0.6;
  }

  .value {
    font-variant-numeric: tabular-nums;
  }

  @container (width < 420px) {
    .calendar {
      grid-template-columns: repeat(var(--half), 1fr);
      row-gap: 14px;
    }

    .month[data-narrow] {
      visibility: visible;
    }

    .month:not([data-narrow]) {
      visibility: hidden;
    }

    .count {
      font-size: 28px;
    }

    .date {
      font-size: 14px;
    }

    .legend {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px 16px;
    }

    .legend li {
      justify-content: start;
    }

    .legend .value {
      margin-left: auto;
    }
  }

  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .readout,
    .week,
    .day,
    .legend {
      animation: fade 420ms var(--ease-out) backwards paused;
    }

    .week {
      animation-delay: calc(sibling-index() * 8ms);
    }

    .day {
      animation-delay: calc(sibling-index() * 14ms);
    }

    .legend {
      animation-delay: 420ms;
    }

    .screen[data-on] :is(.readout, .week, .day, .legend) {
      animation-play-state: running;
    }
  }
</style>
