---
import activity from "../data/activity.json";
import Grouped from "./Grouped.astro";
import { contributions, weeks } from "../lib/data";

const format = new Intl.NumberFormat("en-US");
const month = new Intl.DateTimeFormat("en-US", { month: "short", timeZone: "UTC" });
const short = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
const long = new Intl.DateTimeFormat("en-US", { weekday: "short", month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });

const plural = (count: number, word: string) => (count === 1 ? word : `${word}s`);

const total = format.format(contributions.total.lastYear);
const padding = 7 - (weeks[0]?.length ?? 7);

const date = (week: number, at: number) => new Date(weeks[week]?.at(at)?.date ?? "");
const startsMonth = (week: number) => date(week, -1).getUTCDate() <= 7;

const labelled = (week: number, first: number, end: number) =>
  week <= end - 4 && (startsMonth(week) || (week === first && !startsMonth(week + 1) && !startsMonth(week + 2)));

const columns = weeks.map((week, index) => ({
  week,
  label: month.format(date(index, startsMonth(index) ? -1 : 0)),
  wide: labelled(index, 0, weeks.length),
}));

const days = activity.days.map((entry) => new Date(entry));
const daily: Record<string, number[]> = activity.daily;

const tracks = Object.keys(activity.repos)
  .map((id) => ({ id, counts: daily[id] ?? [] }))
  .map(({ id, counts }) => ({ id, counts, sum: counts.reduce((a, b) => a + b, 0) }))
  .filter(({ sum }) => sum > 0)
  .toSorted((a, b) => b.sum - a.sum);

const commits = format.format(tracks.reduce((all, { sum }) => all + sum, 0));
const peak = Math.max(...tracks.flatMap(({ counts }) => counts), 1);
const glow = (count: number) => (count === 0 ? 0 : 0.28 + 0.72 * Math.sqrt(count / peak));
---

<div class="activity">
  <div class="screen" data-readout data-boot>
    <div class="readout">
      <p>
        <span class="count dot lit" data-show="count" data-group data-idle={total}><Grouped text={total} /></span>
        <span class="unit" data-show="unit" data-idle="contributions">contributions</span>
      </p>
      <span class="when" data-show="date" data-idle="Last 12 months">Last 12 months</span>
    </div>
    <div class="calendar-scroll" tabindex="0" role="region" aria-label="Contribution calendar, scroll for earlier months">
      <div class="calendar" style={`--weeks: ${weeks.length}`}>
        {
          columns.map(({ week, label, wide }, index) => (
            <div class="week">
              <span class="month" data-wide={wide ? "" : undefined}>
                {wide ? label : ""}
              </span>
              {index === 0 && Array.from({ length: padding }, () => <span />)}
              {week.map((entry) => (
                <span
                  class="cell"
                  data-level={entry.level}
                  data-tip
                  data-count={format.format(entry.count)}
                  data-unit={plural(entry.count, "contribution")}
                  data-date={long.format(new Date(entry.date))}
                />
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="screen" data-readout data-boot>
    <div class="readout">
      <p>
        <span class="count dot lit" data-show="count" data-group data-idle={commits}><Grouped text={commits} /></span>
        <span class="unit" data-show="unit" data-idle="commits">commits</span>
      </p>
      <span class="when" data-show="date" data-idle="Last 30 days">Last 30 days</span>
    </div>
    <div class="tracks" style={`--days: ${days.length}`}>
      {
        tracks.map(({ id, counts, sum }) => (
          <div class="track">
            <span class="name">{id}</span>
            {counts.map((count, i) => (
              <span
                class="tick"
                style={`--glow: ${glow(count)}`}
                data-bright={glow(count) >= 0.75 ? "" : undefined}
                data-tip
                data-count={format.format(count)}
                data-unit={plural(count, "commit")}
                data-date={`${id} · ${short.format(days[i])}`}
              />
            ))}
            <span class="sum">{format.format(sum)}</span>
          </div>
        ))
      }
      <div class="track axis">
        {days.map((entry, i) =>
          (days.length - 1 - i) % 7 === 0 ? <span style={`grid-column: ${i + 2}`}>{short.format(entry)}</span> : null,
        )}
      </div>
    </div>
  </div>
</div>

<script>
  for (const scroll of document.querySelectorAll<HTMLElement>(".calendar-scroll")) {
    const edges = () => {
      scroll.style.setProperty("--fade-left", scroll.scrollLeft > 1 ? "14px" : "0px");
      scroll.style.setProperty("--fade-right", scroll.scrollLeft < scroll.scrollWidth - scroll.clientWidth - 1 ? "14px" : "0px");
    };

    scroll.addEventListener("scroll", edges, { passive: true });
    scroll.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
        event.stopPropagation();
      }
    });
    let end = true;
    scroll.addEventListener("scroll", () => {
      end = scroll.scrollLeft >= scroll.scrollWidth - scroll.clientWidth - 1;
    }, { passive: true });
    new ResizeObserver(() => {
      if (end) {
        scroll.scrollLeft = scroll.scrollWidth;
      }

      edges();
    }).observe(scroll);
  }
</script>

<style>
  .activity {
    display: grid;
    gap: 28px;
  }

  .screen {
    padding: 18px 18px 16px;
    container-type: inline-size;
  }

  .readout {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }

  .readout p {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
  }

  .count {
    font-size: 34px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .count :global(.comma) {
    margin-inline: -0.04em -0.26em;
  }

  .unit,
  .when,
  .month,
  .track > span {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--seg);
  }

  .unit,
  .when {
    opacity: 0.6;
  }

  .when {
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: right;
  }

  .calendar-scroll {
    overflow-x: auto;
    padding: 6px;
    margin: -6px;
    scroll-padding-inline: 20px;
    scrollbar-width: none;
    mask-image: linear-gradient(to right, transparent, black var(--fade-left, 0px), black calc(100% - var(--fade-right, 0px)), transparent);
  }

  .calendar-scroll::-webkit-scrollbar {
    display: none;
  }

  .calendar {
    display: grid;
    --gap: clamp(2px, 0.5cqi, 3px);

    grid-template-columns: repeat(var(--weeks), 1fr);
    gap: var(--gap);
  }

  .week {
    display: grid;
    gap: var(--gap);
    align-content: start;
  }

  .month {
    height: 14px;
    width: 0;
    overflow: visible;
    font-size: 9px;
    letter-spacing: 0.1em;
    opacity: 0.45;
  }

  .month:not([data-wide]) {
    visibility: hidden;
  }

  .week > span:not(.month) {
    aspect-ratio: 1;
  }

  .cell,
  .tick {
    background: color-mix(in oklab, var(--seg) calc(var(--glow, 0) * 100%), var(--seg-off));
  }

  .cell {
    border-radius: 2px;
  }

  .cell[data-level="1"] {
    --glow: 0.3;
  }

  .cell[data-level="2"] {
    --glow: 0.52;
  }

  .cell[data-level="3"] {
    --glow: 0.75;
  }

  .cell[data-level="4"] {
    --glow: 1;
  }

  :is(.cell[data-level="4"], .tick[data-bright]) {
    box-shadow: var(--seg-glow);
  }

  :is(.cell, .tick)[data-picked] {
    outline: 1px solid var(--seg);
    outline-offset: 1px;
  }

  @media (hover: hover) and (pointer: fine) {
    :is(.cell, .tick):hover {
      outline: 1px solid var(--seg);
      outline-offset: 1px;
    }
  }

  .tracks {
    display: grid;
    gap: 6px;
    touch-action: pan-y;
  }

  .track {
    display: grid;
    grid-template-columns: min(136px, 26%) repeat(var(--days), 1fr) 36px;
    align-items: center;
    gap: clamp(1.5px, 0.4cqi, 2px);
  }

  .track > span:not(.tick) {
    font-size: 9px;
    letter-spacing: 0.1em;
    opacity: 0.6;
    transition: opacity 120ms;
  }

  .track:has([data-picked]) > span {
    opacity: 1;
  }

  .name {
    overflow: hidden;
    text-overflow: ellipsis;
    padding-right: 10px;
  }

  .sum {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .tick {
    height: 10px;
    border-radius: 1.5px;
  }

  .axis {
    margin-top: 6px;
  }

  .axis > span {
    grid-row: 1;
    width: 0;
    overflow: visible;
    opacity: 0.45;
  }

  @container (width < 420px) {
    .calendar {
      width: 200%;
    }

    .count {
      font-size: 30px;
    }

    .readout {
      gap: 12px;
    }

    .readout p {
      gap: 8px;
    }

    .unit,
    .when {
      font-size: 9.5px;
      letter-spacing: 0.06em;
    }

    .track {
      grid-template-columns: 31% repeat(var(--days), 1fr) 26px;
    }

    .track > span:not(.tick) {
      letter-spacing: 0.04em;
    }

    .name {
      padding-right: 6px;
    }

    .axis > span:nth-last-child(even) {
      display: none;
    }
  }

  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .readout,
    .week,
    .track {
      animation: fade 420ms var(--ease-out) backwards paused;
    }

    .week {
      animation-delay: calc((sibling-count() - sibling-index()) * 8ms);
    }

    .track {
      animation-delay: calc(sibling-index() * 24ms);
    }

    .screen[data-on] :is(.readout, .week, .track) {
      animation-play-state: running;
    }
  }
</style>
