---
import activity from "../data/activity.json";
import { contributions, weeks } from "../lib/data";

const HUES = 7;

const digits = new Intl.NumberFormat("en-US", { useGrouping: false });
const month = new Intl.DateTimeFormat("en-US", { month: "short", timeZone: "UTC" });
const short = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
const long = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });

const plural = (count: number, word: string) => (count === 1 ? word : `${word}s`);
const sum = (counts: number[]) => counts.reduce((a, b) => a + b, 0);

const padding = 7 - (weeks[0]?.length ?? 7);
const split = Math.ceil(weeks.length / 2);

const last = (week: number) => new Date(weeks[week]?.at(-1)?.date ?? "");
const startsMonth = (week: number) => last(week).getUTCDate() <= 7;

const LABEL = 3;

const bandLabels = (first: number, end: number, mode: string) => {
  const kept: number[] = [];

  const stop = end === weeks.length ? end : end - LABEL + 1;

  for (let week = first; week < stop; week += 1) {
    const previous = kept.at(-1);

    if (week !== first && !startsMonth(week)) {
      continue;
    }

    if (previous === undefined || Math.min(week, end - LABEL) >= previous + LABEL) {
      kept.push(week);
    } else if (previous === first && !startsMonth(first)) {
      kept[kept.length - 1] = week;
    }
  }

  return kept.map((week) => ({ week, mode, after: week > end - LABEL ? end - 1 - week : undefined }));
};

const labels = [
  ...bandLabels(0, weeks.length, "wide"),
  ...bandLabels(0, split, "narrow"),
  ...bandLabels(split, weeks.length, "narrow"),
];

const calendar = new Map(contributions.contributions.map(({ date, count }) => [date, count]));
const days = activity.days.map((entry) => new Date(entry));
const daily: Record<string, number[]> = activity.daily;

const ranked = Object.entries(daily).map(([name, counts]) => ({ name, counts }));
const tail = ranked.slice(HUES);

const series = [
  ...ranked.slice(0, HUES).map(({ name, counts }, hue) => ({ name, counts, hue: String(hue) })),
  {
    name: `${tail.length} ${plural(tail.length, "other")}`,
    counts: days.map((_, i) => sum(tail.map(({ counts }) => counts[i] ?? 0))),
    hue: "more",
  },
  {
    name: "private",
    counts: activity.days.map((day, i) => Math.max(0, (calendar.get(day) ?? 0) - sum(ranked.map(({ counts }) => counts[i] ?? 0)))),
    hue: "private",
  },
].filter(({ counts }) => sum(counts) > 0);

const totals = days.map((_, i) => sum(series.map(({ counts }) => counts[i] ?? 0)));
const peak = Math.max(...totals, 1);
const step = [1, 10, 100, 1000].flatMap((p) => [1, 2, 5].map((m) => m * p)).find((s) => s * 3 >= peak) ?? peak;
const scale = Math.max(peak, Math.floor(peak / step) * step);
const grid = Array.from({ length: Math.floor(scale / step) }, (_, i) => (i + 1) * step);

const marks = days.filter((_, i) => i === days.length - 1 || (i % 7 === 0 && i < days.length - 7));

const ticks = new Map(
  marks.map((day, n) => {
    const previous = marks[n - 1];

    return [day, previous && month.format(previous) === month.format(day) ? String(day.getUTCDate()) : short.format(day)];
  }),
);

const others = tail.map(({ name, counts }) => `${name}\u00A0${digits.format(sum(counts))}`).join("\u00A0· ");
---

<div class="activity">
  <figure>
    <figcaption><span class="dot">01</span><span class="label">Last 12 months</span></figcaption>
    <div
      class="screen"
      data-readout
      data-boot
      tabindex="0"
      aria-label="Contributions in the last 12 months. Arrow keys step through days."
    >
      <p class="readout" aria-live="polite">
        <span class="count dot lit" data-show="count" data-idle={digits.format(contributions.total.lastYear)}
          >{digits.format(contributions.total.lastYear)}</span
        >
        <span class="unit label" data-show="unit" data-idle="contributions">contributions</span>
        <span class="date dot lit" data-show="date" data-idle=""></span>
      </p>
      <div class="calendar" style={`--weeks: ${weeks.length}; --columns: ${split}`}>
        {
          weeks.map((week, index) => (
            <div class="week">
              <span class="month">
                {labels
                  .filter((mark) => mark.week === index)
                  .map(({ mode, after }) => (
                    <span
                      class="label"
                      data-mode={mode}
                      data-end={after === undefined ? undefined : ""}
                      style={after === undefined ? undefined : `--after: ${after}`}
                    >
                      {month.format(last(index))}
                    </span>
                  ))}
              </span>
              {index === 0 && Array.from({ length: padding }, () => <span />)}
              {week.map((entry) => (
                <span
                  class="cell"
                  data-level={entry.level}
                  data-tip
                  data-count={digits.format(entry.count)}
                  data-unit={plural(entry.count, "contribution")}
                  data-date={long.format(new Date(entry.date))}
                />
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </figure>

  <figure>
    <figcaption><span class="dot">02</span><span class="label">Last 30 days, by project</span></figcaption>
    <div
      class="screen"
      data-readout
      data-boot
      tabindex="0"
      aria-label="Contributions per project in the last 30 days. Arrow keys step through days."
    >
      <p class="readout" aria-live="polite">
        <span class="count dot lit" data-show="count" data-idle={digits.format(sum(totals))}
          >{digits.format(sum(totals))}</span
        >
        <span class="unit label" data-show="unit" data-idle="contributions">contributions</span>
        <span class="date dot lit" data-show="date" data-idle=""></span>
      </p>
      <div class="plot">
        {
          grid.map((value) => (
            <span class="rule" style={`--at: ${value / scale}`}>
              <span class="label">{digits.format(value)}</span>
            </span>
          ))
        }
        <div class="chart" style={`--days: ${days.length}`}>
          {
            days.map((entry, i) => (
              <span
                class="day"
                data-tip
                data-count={digits.format(totals[i] ?? 0)}
                data-unit={plural(totals[i] ?? 0, "contribution")}
                data-date={long.format(entry)}
                {...Object.fromEntries(series.map(({ counts }, s) => [`data-s${s}`, counts[i] ? digits.format(counts[i]) : ""]))}
              >
                <span class="bar">
                  <span class="stack" style={`height: ${((totals[i] ?? 0) / scale) * 100}%`}>
                    {series.map(({ counts, hue }) => {
                      const share = ((counts[i] ?? 0) / scale) * 100;
                      return share > 0 ? (
                        <span
                          class="seg"
                          data-hue={hue}
                          data-split={share >= 3 ? "" : undefined}
                          style={`height: ${((counts[i] ?? 0) / (totals[i] || 1)) * 100}%`}
                        />
                      ) : null;
                    })}
                  </span>
                </span>
                <span class="tick">{ticks.has(entry) && <span class="label">{ticks.get(entry)}</span>}</span>
              </span>
            ))
          }
        </div>
      </div>
      <ul class="legend">
        {
          series
            .map((entry, s) => ({ ...entry, s }))
            .toSorted((a, b) => Number(a.hue === "more") - Number(b.hue === "more"))
            .map(({ name, counts, hue, s }) => {
              const key = (
                <>
                  <span class="swatch" />
                  <span class="label name">{name}</span>
                  <span class="label value" data-show={`s${s}`} data-idle={digits.format(sum(counts))}>
                    {digits.format(sum(counts))}
                  </span>
                </>
              );
              return (
                <li data-hue={hue}>
                  {hue === "more" ? (
                    <details>
                      <summary>{key}</summary>
                      <p class="label members">{others}</p>
                    </details>
                  ) : (
                    key
                  )}
                </li>
              );
            })
        }
      </ul>
    </div>
  </figure>
</div>

<style>
  .activity {
    --h0: #46cfb2;
    --h1: #ee6f5a;
    --h2: #6f9cf2;
    --h3: #e2a03a;
    --h4: #dd80b0;
    --h5: #a5c94e;
    --h6: #a98cf0;
    --h-more: color-mix(in oklab, var(--ink) 34%, var(--screen));
    --h-private: color-mix(in oklab, var(--seg) 70%, transparent);

    display: grid;
    gap: 48px;
  }

  :root[data-finish="silver"] .activity {
    --h0: #00806a;
    --h1: #c0392b;
    --h2: #3456b8;
    --h3: #9a5b00;
    --h4: #a8327a;
    --h5: #557a00;
    --h6: #6b46c1;
    --h-more: color-mix(in oklab, var(--ink) 40%, var(--screen));
    --h-private: color-mix(in oklab, var(--seg) 60%, transparent);
  }

  figure {
    margin: 0;
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  figcaption .dot {
    font-size: 11px;
    color: var(--ink-3);
  }

  figcaption .label {
    color: var(--ink-2);
  }

  figcaption::after {
    flex: 1;
    height: 1px;
    content: "";
    background: var(--line);
  }

  .screen {
    padding: 18px 20px 20px;
    container-type: inline-size;
    touch-action: pan-y;
  }

  .readout {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 18px;
  }

  .count {
    font-size: 32px;
    line-height: 1;
  }

  .unit {
    color: var(--seg);
    opacity: 0.6;
  }

  .date {
    margin-left: auto;
    font-size: 16px;
    line-height: 1;
    white-space: nowrap;
  }

  .label {
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.1em;
    white-space: nowrap;
    color: var(--seg);
  }

  .calendar {
    display: grid;
    --gap: clamp(1.5px, 0.5cqi, 3px);

    grid-template-columns: repeat(var(--weeks), 1fr);
    gap: var(--gap);
  }

  .week {
    display: grid;
    gap: var(--gap);
    align-content: start;
  }

  .month {
    position: relative;
    height: 16px;
  }

  .month .label {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0.7;
  }

  .month [data-end] {
    right: calc(var(--after) * -1 * (100% + var(--gap)));
    left: auto;
  }

  .month [data-mode="narrow"] {
    display: none;
  }

  .week > span:not(.month) {
    aspect-ratio: 1;
  }

  .cell {
    position: relative;
    border-radius: clamp(1px, 0.3cqi, 2px);
    background: color-mix(in oklab, var(--seg) calc(var(--glow, 0) * 100%), var(--seg-off));
    outline: 1.5px solid transparent;
    outline-offset: 1px;
    transition: outline-color 120ms;
  }

  .cell::after {
    position: absolute;
    inset: calc(var(--gap) / -2);
    content: "";
  }

  .cell[data-picked] {
    outline-color: var(--ink);
  }

  .cell[data-level="1"] {
    --glow: 0.3;
  }

  .cell[data-level="2"] {
    --glow: 0.52;
  }

  .cell[data-level="3"] {
    --glow: 0.75;
  }

  .cell[data-level="4"] {
    --glow: 1;

    box-shadow: var(--seg-glow);
  }

  .plot {
    position: relative;
    --height: clamp(112px, 24cqi, 136px);

    padding-left: 28px;
  }

  .rule {
    position: absolute;
    right: 0;
    bottom: calc(22px + var(--at) * var(--height));
    left: 0;
    border-top: 1px dashed var(--seg-off);
  }

  .rule .label {
    position: absolute;
    left: 0;
    translate: 0 -50%;
    opacity: 0.6;
  }

  .chart {
    display: grid;
    --gap: clamp(2px, 1.1cqi, 7px);

    grid-template-columns: repeat(var(--days), 1fr);
  }

  .day {
    display: grid;
    grid-template-rows: var(--height) 22px;
    padding-inline: calc(var(--gap) / 2);
  }

  .bar {
    display: flex;
    align-items: end;
    background: linear-gradient(var(--seg-off), var(--seg-off)) bottom / 100% 2px no-repeat;
  }

  .stack {
    display: flex;
    flex-direction: column-reverse;
    width: 100%;
    border-radius: 2px 2px 0 0;
    outline: 1.5px solid transparent;
    outline-offset: 1.5px;
    transition: outline-color 120ms;
  }

  .day[data-picked] .stack {
    min-height: 2px;
    outline-color: var(--ink);
  }

  .seg {
    flex: none;
    background: var(--hue);
  }

  .seg:last-child {
    border-radius: 2px 2px 0 0;
  }

  .seg[data-split]:not(:last-child) {
    box-shadow: inset 0 1px var(--screen);
  }

  :global(:root:not([data-finish="silver"])) .seg:is([data-hue="0"], [data-hue="1"], [data-hue="2"], [data-hue="3"], [data-hue="4"], [data-hue="5"], [data-hue="6"]) {
    filter: drop-shadow(0 0 3px color-mix(in srgb, var(--hue) 40%, transparent));
  }

  [data-hue="0"] {
    --hue: var(--h0);
  }

  [data-hue="1"] {
    --hue: var(--h1);
  }

  [data-hue="2"] {
    --hue: var(--h2);
  }

  [data-hue="3"] {
    --hue: var(--h3);
  }

  [data-hue="4"] {
    --hue: var(--h4);
  }

  [data-hue="5"] {
    --hue: var(--h5);
  }

  [data-hue="6"] {
    --hue: var(--h6);
  }

  [data-hue="more"] {
    --hue: var(--h-more);
  }

  [data-hue="private"] {
    --hue: repeating-linear-gradient(-45deg, var(--h-private) 0 1.5px, transparent 1.5px 3.5px);
  }

  .tick {
    position: relative;
  }

  .tick .label {
    position: absolute;
    top: 9px;
    left: 50%;
    translate: -50%;
    opacity: 0.7;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin: 16px 0 0;
    padding: 14px 0 0;
    border-top: 1px solid var(--seg-off);
    list-style: none;
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: 7px;
    transition: opacity 140ms;
  }

  .swatch {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--hue);
  }

  .legend .label {
    font-size: 10px;
    letter-spacing: 0.08em;
  }

  .name {
    opacity: 0.75;
  }

  .value {
    min-width: 3ch;
    font-variant-numeric: tabular-nums;
  }

  .value:empty::before {
    content: "–";
  }

  .legend li:has(.value:empty) {
    opacity: 0.45;
  }

  .legend li:has(details[open]) {
    flex-basis: 100%;
  }

  details {
    flex: 1;
  }

  summary {
    display: flex;
    gap: 7px;
    align-items: center;
    width: fit-content;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    width: 5px;
    height: 5px;
    margin-left: 2px;
    content: "";
    border-right: 1px solid var(--seg);
    border-bottom: 1px solid var(--seg);
    opacity: 0.7;
    rotate: 45deg;
    translate: 0 -2px;
    transition: rotate 160ms var(--ease-out), translate 160ms var(--ease-out);
  }

  details[open] summary::after {
    rotate: 225deg;
    translate: 0 1px;
  }

  .members {
    margin: 8px 0 0;
    padding-left: 15px;
    line-height: 1.7;
    letter-spacing: 0.04em;
    white-space: normal;
    text-transform: none;
    opacity: 0.55;
  }


  @container (width < 420px) {
    .calendar {
      grid-template-columns: repeat(var(--columns), 1fr);
      row-gap: 14px;
    }

    .month [data-mode="wide"] {
      display: none;
    }

    .month [data-mode="narrow"] {
      display: block;
    }

    .count {
      font-size: 28px;
    }

    .date {
      font-size: 14px;
    }
  }

  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .readout,
    .week,
    .day,
    .rule,
    .legend {
      animation: fade 420ms var(--ease-out) backwards paused;
    }

    .week {
      animation-delay: calc(sibling-index() * 8ms);
    }

    .day {
      animation-delay: calc(sibling-index() * 14ms);
    }

    .legend {
      animation-delay: 420ms;
    }

    .screen[data-on] :is(.readout, .week, .day, .rule, .legend) {
      animation-play-state: running;
    }
  }
</style>
