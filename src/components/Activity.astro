---
import activity from "../data/activity.json";
import { contributions, weeks } from "../lib/data";

const format = new Intl.NumberFormat("en-US");
const month = new Intl.DateTimeFormat("en-US", { month: "short", timeZone: "UTC" });
const long = new Intl.DateTimeFormat("en-US", { month: "short", day: "2-digit", year: "numeric", timeZone: "UTC" });
const total = format.format(contributions.total.lastYear);
const short = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", timeZone: "UTC" });

const days = activity.days.map((day) => new Date(day));

const tracks = Object.entries(activity.repos)
  .map(([id, { daily }]) => ({ id, daily, sum: daily.reduce((a, b) => a + b, 0) }))
  .filter(({ sum }) => sum > 0)
  .toSorted((a, b) => b.sum - a.sum);

const peak = Math.max(...tracks.flatMap(({ daily }) => daily));
const glow = (count: number) => (count === 0 ? 0 : 0.25 + 0.75 * Math.sqrt(count / peak));

const columns = weeks.map((week, index) => {
  const first = new Date(week[0]?.date ?? "");
  const starts = index > 0 && index < weeks.length - 2 && first.getUTCDate() <= 7;

  return { week, label: starts ? month.format(first) : "" };
});
---

<div class="display screen" data-readout data-boot>
  <div class="readout">
    <span class="count dot lit" data-show="count" data-idle={total}>{total}</span>
    <span class="label" data-show="unit" data-idle="Contributions">Contributions</span>
    <span class="label date" data-show="date" data-idle="Last 12 months">Last 12 months</span>
  </div>
  <div class="calendar">
    {
      columns.map(({ week, label }) => (
        <div class="week">
          <span class="month label">{label}</span>
          {week.map((entry) => (
            <span
              class="cell"
              data-level={entry.level}
              data-tip
              data-count={format.format(entry.count)}
              data-unit={entry.count === 1 ? "Contribution" : "Contributions"}
              data-date={long.format(new Date(entry.date))}
            />
          ))}
        </div>
      ))
    }
  </div>
  <div class="tracks" style={`--days: ${days.length}`}>
    <div class="heading">
      <span class="label">Commits by project</span>
      <span class="label">Last 30 days</span>
    </div>
    {
      tracks.map(({ id, daily, sum }) => (
        <div class="track">
          <span class="name label">{id}</span>
          {daily.map((count, i) => (
            <span
              class="tick"
              style={`--glow: ${glow(count)}`}
              data-lit={count > 0 ? "" : undefined}
              data-tip
              data-count={format.format(count)}
              data-unit={count === 1 ? "Commit" : "Commits"}
              data-date={`${id} · ${short.format(days[i])}`}
            />
          ))}
          <span class="sum label">{sum}</span>
        </div>
      ))
    }
    <div class="track axis">
      {days.map((day, i) => (i % 7 === 0 ? <span class="label" style={`grid-column: ${i + 2}`}>{day.toISOString().slice(5, 10).replace("-", ".")}</span> : null))}
    </div>
  </div>
</div>

<style>
  .display {
    padding: 18px 18px 16px;
  }

  .readout {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 8px 16px;
    margin-bottom: 18px;
  }

  .count {
    grid-column: 1 / -1;
  }

  .count {
    font-size: 34px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .readout .label {
    color: var(--seg);
    opacity: 0.6;
  }

  .date {
    text-align: right;
  }

  .calendar {
    display: grid;
    grid-auto-columns: 1fr;
    grid-auto-flow: column;
    gap: 3px;
    container-type: inline-size;
  }

  .week {
    display: grid;
    grid-template-rows: 14px repeat(7, auto);
    align-content: start;
    gap: 3px;
  }

  @container (max-width: 420px) {
    .week:nth-last-child(n + 27) {
      display: none;
    }
  }

  .month {
    width: 0;
    overflow: visible;
    font-size: 9px;
    letter-spacing: 0.1em;
    white-space: nowrap;
    color: var(--seg);
    opacity: 0.45;
  }

  .cell {
    aspect-ratio: 1;
    border-radius: 2px;
    background: var(--seg);
    box-shadow: var(--seg-glow);
    transition: opacity 120ms;
  }

  .cell[data-level="0"] {
    background: var(--seg-off);
    box-shadow: none;
  }

  .cell[data-level="1"] {
    opacity: 0.3;
  }

  .cell[data-level="2"] {
    opacity: 0.52;
  }

  .cell[data-level="3"] {
    opacity: 0.75;
  }

  .cell:hover {
    outline: 1px solid var(--seg);
    outline-offset: 1px;
  }

  .tracks {
    container-type: inline-size;
    display: grid;
    gap: 5px;
    margin-top: 22px;
    padding-top: 16px;
    border-top: 1px dashed var(--seg-off);
  }

  .heading {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .heading .label {
    color: var(--seg);
    opacity: 0.6;
  }

  .track {
    display: grid;
    grid-template-columns: min(136px, 28%) repeat(var(--days), 1fr) 32px;
    align-items: center;
    gap: 2px;
  }

  .track .label {
    font-size: 9px;
    letter-spacing: 0.1em;
    white-space: nowrap;
    color: var(--seg);
    opacity: 0.6;
  }

  .name {
    overflow: hidden;
    text-overflow: ellipsis;
    padding-right: 8px;
  }

  .sum {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .tick {
    height: 9px;
    border-radius: 1.5px;
    background: var(--seg-off);
  }

  .tick[data-lit] {
    background: var(--seg);
    box-shadow: var(--seg-glow);
    opacity: var(--glow);
  }

  .tick:hover {
    outline: 1px solid var(--seg);
    outline-offset: 1px;
  }

  .axis {
    margin-top: 4px;
  }

  @container (max-width: 420px) {
    .axis .label:nth-child(even) {
      display: none;
    }
  }

  .axis .label {
    grid-row: 1;
    width: 0;
    overflow: visible;
    opacity: 0.45;
  }

  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .readout,
    .week,
    .track {
      animation: fade 420ms var(--ease-out) backwards paused;
    }

    .week {
      animation-delay: calc((sibling-count() - sibling-index()) * 8ms);
    }

    .display[data-on] :is(.readout, .week, .track) {
      animation-play-state: running;
    }
  }
</style>
