---
import activity from "../data/activity.json";
import { contributions, weeks } from "../lib/data";

const HUES = 4;

const format = new Intl.NumberFormat("en-US");
const digits = new Intl.NumberFormat("en-US", { useGrouping: false });
const month = new Intl.DateTimeFormat("en-US", { month: "short", timeZone: "UTC" });
const short = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
const long = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });

const plural = (count: number, word: string) => (count === 1 ? word : `${word}s`);
const sum = (counts: number[]) => counts.reduce((a, b) => a + b, 0);

const total = digits.format(contributions.total.lastYear);
const padding = 7 - (weeks[0]?.length ?? 7);

const trim = weeks.length % 2;
const half = (weeks.length - trim) / 2;
const date = (week: number, at: number) => new Date(weeks[week]?.at(at)?.date ?? "");
const startsMonth = (week: number) => date(week, -1).getUTCDate() <= 7;
const soon = (week: number, end: number) => [1, 2, 3].some((ahead) => week + ahead < end && startsMonth(week + ahead));

const labelled = (week: number, first: number, end: number) =>
  week <= end - 3 && (startsMonth(week) || (week === first && !soon(week, end)));

const columns = weeks.map((week, index) => {
  const first = index < trim + half ? trim : trim + half;

  return {
    week,
    label: month.format(date(index, startsMonth(index) ? -1 : 0)),
    wide: labelled(index, 0, weeks.length),
    narrow: index >= trim && labelled(index, first, first + half),
  };
});

const days = activity.days.map((entry) => new Date(entry));

const projects = Object.entries(activity.repos)
  .map(([id, { daily }]) => ({ id, daily, total: sum(daily) }))
  .filter(({ total: commits }) => commits > 0)
  .toSorted((a, b) => b.total - a.total)
  .map((project, rank) => ({ ...project, hue: Math.min(rank, HUES) }));

const rest = days.map((_, i) => sum(projects.slice(HUES).map(({ daily }) => daily[i] ?? 0)));

const totals = days.map((_, i) => sum(projects.map(({ daily }) => daily[i] ?? 0)));
const peak = Math.max(...totals);
const commits = sum(totals);

const ticks = new Set(days.map((_, i) => i).filter((i) => (days.length - 1 - i) % 7 === 0));
---


<div class="activity">
  <figure>
    <figcaption><span class="dot">01</span><span class="label">Last 12 months</span></figcaption>
    <div
      class="screen"
      data-readout
      data-link="activity"
      data-boot
      tabindex="0"
      aria-label="Contributions in the last 12 months. Arrow keys step through days."
    >
      <p class="readout" aria-live="polite">
        <span class="count dot lit" data-show="count" data-idle={total}>{total}</span>
        <span class="unit label" data-show="unit" data-idle="contributions">contributions</span>
        <span class="date dot lit" data-show="date" data-idle=""></span>
      </p>
      <div class="calendar" style={`--weeks: ${weeks.length}; --half: ${half}`}>
        {
          columns.map(({ week, label, wide, narrow }, index) => (
            <div class="week" data-trim={index < trim ? "" : undefined}>
              <span class="month label" data-wide={wide ? "" : undefined} data-narrow={narrow ? "" : undefined}>
                {wide || narrow ? label : ""}
              </span>
              {index === 0 && Array.from({ length: padding }, () => <span />)}
              {week.map((entry) => (
                <span
                  class="cell"
                  data-level={entry.level}
                  data-tip
                  data-day={entry.date}
                  data-count={digits.format(entry.count)}
                  data-unit={plural(entry.count, "contribution")}
                  data-date={long.format(new Date(entry.date))}
                />
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </figure>

  <figure>
    <figcaption><span class="dot">02</span><span class="label">Last 30 days, by project</span></figcaption>
    <div
      class="screen"
      data-readout
      data-link="activity"
      data-boot
      tabindex="0"
      aria-label="Commits per project in the last 30 days. Arrow keys step through days."
    >
      <p class="readout" aria-live="polite">
        <span class="count dot lit" data-show="count" data-idle={digits.format(commits)}>{digits.format(commits)}</span>
        <span class="unit label" data-show="unit" data-idle="commits">commits</span>
        <span class="date dot lit" data-show="date" data-idle=""></span>
      </p>
      <div class="chart" style={`--days: ${days.length}`}>
        {
          days.map((entry, i) => (
            <span
              class="day"
              data-tip
              data-day={activity.days[i]}
              data-count={digits.format(totals[i] ?? 0)}
              data-unit={plural(totals[i] ?? 0, "commit")}
              data-date={long.format(entry)}
              {...Object.fromEntries(projects.map(({ daily }, p) => [`data-p${p}`, daily[i] ? format.format(daily[i]) : ""]))}
            >
              <span class="bar">
                <span class="fill" style={`height: ${Math.sqrt((totals[i] ?? 0) / peak) * 100}%`}>
                  {projects
                    .slice(0, HUES)
                    .map(({ daily }, p) =>
                      daily[i] ? <span class="seg" data-project={p} data-hue={p} style={`flex-grow: ${daily[i]}`} /> : null,
                    )}
                  {(rest[i] ?? 0) > 0 && (
                    <span class="rest" data-hue={HUES} style={`flex-grow: ${rest[i]}`}>
                      {projects
                        .slice(HUES)
                        .map(({ daily }, p) =>
                          daily[i] ? <span class="seg" data-project={p + HUES} style={`flex-grow: ${daily[i]}`} /> : null,
                        )}
                    </span>
                  )}
                </span>
              </span>
              <span class="tick">{ticks.has(i) && <span class="label">{short.format(entry)}</span>}</span>
            </span>
          ))
        }
      </div>
      <ul class="legend">
        {
          projects.map(({ id, total: count, hue }, p) => (
            <li data-hue={hue}>
              <button type="button" data-solo={p} aria-pressed="false">
                <span class="swatch" />
                <span class="label name">{id}</span>
                <span class="label value" data-show={`p${p}`} data-idle={format.format(count)}>
                  {format.format(count)}
                </span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </figure>
</div>

<script>
  const at = (event: Event) =>
    event.target instanceof Element ? event.target.closest<HTMLElement>("[data-solo]")?.dataset.solo : undefined;

  const wire = (legend: HTMLElement) => {
    const chart = legend.previousElementSibling;
    const buttons = legend.querySelectorAll<HTMLButtonElement>("[data-solo]");
    let pinned: string | undefined;

    const solo = (project?: string) => {
      for (const target of [legend, chart]) {
        target?.toggleAttribute("data-solo", project !== undefined);
      }

      for (const seg of chart?.querySelectorAll<HTMLElement>(".seg") ?? []) {
        seg.toggleAttribute("data-on", seg.dataset.project === project);
      }

      for (const button of buttons) {
        button.ariaPressed = String(button.dataset.solo === project);
      }
    };

    legend.addEventListener("click", (event) => {
      const project = at(event);
      pinned = pinned === project ? undefined : project;
      solo(pinned);
    });

    legend.addEventListener("pointerover", (event) => {
      if (event.pointerType === "mouse") {
        solo(at(event) ?? pinned);
      }
    });

    legend.addEventListener("pointerleave", (event) => {
      if (event.pointerType === "mouse") {
        solo(pinned);
      }
    });
  };

  for (const legend of document.querySelectorAll<HTMLElement>(".legend")) {
    wire(legend);
  }
</script>

<style>
  .activity {
    --h0: #f2a33a;
    --h1: #6e8bff;
    --h2: #f25c8c;
    --h3: #c8d94a;
    --h4: #4f5a55;

    display: grid;
    gap: 48px;
  }

  :root[data-finish="silver"] .activity {
    --h0: #b06d0c;
    --h1: #3b5bd0;
    --h2: #c0305f;
    --h3: #6b7f12;
    --h4: #8d958a;
  }

  figure {
    margin: 0;
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  figcaption .dot {
    font-size: 11px;
    color: var(--ink-3);
  }

  figcaption .label {
    color: var(--ink-2);
  }

  figcaption::after {
    flex: 1;
    height: 1px;
    content: "";
    background: var(--line);
  }

  .screen {
    padding: 18px 20px 20px;
    container-type: inline-size;
    touch-action: pan-y;
  }

  .readout {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 18px;
  }

  .count {
    font-size: 32px;
    line-height: 1;
    font-feature-settings: "palt";
  }

  .unit {
    color: var(--seg);
    opacity: 0.6;
  }

  .date {
    margin-left: auto;
    font-size: 16px;
    line-height: 1;
    white-space: nowrap;
    font-feature-settings: "palt";
  }

  .calendar {
    display: grid;
    --gap: clamp(1.5px, 0.5cqi, 3px);

    grid-template-columns: repeat(var(--weeks), 1fr);
    gap: var(--gap);
  }

  .week {
    display: grid;
    gap: var(--gap);
    align-content: start;
  }

  .month {
    height: 16px;
    width: 0;
    overflow: visible;
    font-size: 9.5px;
    letter-spacing: 0.1em;
    white-space: nowrap;
    color: var(--seg);
    opacity: 0.55;
  }

  .month:not([data-wide]) {
    visibility: hidden;
  }

  .week > span:not(.month) {
    aspect-ratio: 1;
  }

  .cell {
    border-radius: clamp(1px, 0.3cqi, 2px);
    background: color-mix(in oklab, var(--seg) calc(var(--glow, 0) * 100%), var(--seg-off));
  }

  .cell[data-level="1"] {
    --glow: 0.3;
  }

  .cell[data-level="2"] {
    --glow: 0.52;
  }

  .cell[data-level="3"] {
    --glow: 0.75;
  }

  .cell[data-level="4"] {
    --glow: 1;

    box-shadow: var(--seg-glow);
  }

  .cell[data-picked] {
    outline: 1.5px solid var(--ink);
    outline-offset: 1px;
  }

  .chart {
    display: grid;
    grid-template-columns: repeat(var(--days), 1fr);
    gap: clamp(2px, 0.6cqi, 4px);
  }

  .day {
    display: grid;
    grid-template-rows: clamp(96px, 22cqi, 128px) 24px;
  }

  .bar {
    display: flex;
    align-items: end;
    border-radius: 2px;
    background: var(--seg-off);
    transition: opacity 140ms;
  }

  .chart:has([data-picked]) .day:not([data-picked]) .bar {
    opacity: 0.45;
  }

  .fill {
    display: flex;
    flex-direction: column-reverse;
    gap: 1px;
    width: 100%;
    overflow: hidden;
    border-radius: 2px;
  }

  .seg {
    flex-basis: 0;
    background: var(--hue);
    transition: opacity 140ms;
  }

  .rest {
    display: flex;
    flex-direction: column-reverse;
    flex-basis: 0;
  }

  :global(:root:not([data-finish="silver"])) .fill > .seg {
    box-shadow: 0 0 6px color-mix(in srgb, var(--hue) 40%, transparent);
  }

  .chart[data-solo] .seg:not([data-on]) {
    opacity: 0.12;
  }

  [data-hue="0"] {
    --hue: var(--h0);
  }

  [data-hue="1"] {
    --hue: var(--h1);
  }

  [data-hue="2"] {
    --hue: var(--h2);
  }

  [data-hue="3"] {
    --hue: var(--h3);
  }

  [data-hue="4"] {
    --hue: var(--h4);
  }

  .tick {
    position: relative;
  }

  .tick .label {
    position: absolute;
    top: 9px;
    left: 50%;
    translate: -50%;
    font-size: 9.5px;
    letter-spacing: 0.1em;
    white-space: nowrap;
    color: var(--seg);
    opacity: 0.55;
  }

  .day:last-child .tick .label {
    right: 0;
    left: auto;
    translate: none;
  }

  .legend {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(144px, 1fr));
    gap: 2px 24px;
    margin: 12px 0 0;
    padding: 12px 0 0;
    border-top: 1px solid var(--seg-off);
    list-style: none;
  }

  .legend button {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    min-width: 0;
    padding: var(--row, 6px) 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: opacity 140ms;
  }

  .swatch {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--hue);
  }

  .legend .label {
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--seg);
  }

  .name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 0.7;
  }

  .value {
    flex: none;
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }

  .value:empty::before {
    content: "–";
  }

  .legend button:has(.value:empty) {
    opacity: 0.35;
  }

  .legend[data-solo] button:not([aria-pressed="true"]) {
    opacity: 0.35;
  }

  @container (width < 420px) {
    .calendar {
      grid-template-columns: repeat(var(--half), 1fr);
      row-gap: 14px;
    }

    .week[data-trim] {
      display: none;
    }

    .month[data-narrow] {
      visibility: visible;
    }

    .month:not([data-narrow]) {
      visibility: hidden;
    }

    .count {
      font-size: 28px;
    }

    .date {
      font-size: 14px;
    }

    .legend {
      --row: 4px;

      grid-template-columns: 1fr;
    }
  }

  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .readout,
    .week,
    .day,
    .legend {
      animation: fade 420ms var(--ease-out) backwards paused;
    }

    .week {
      animation-delay: calc(sibling-index() * 8ms);
    }

    .day {
      animation-delay: calc(sibling-index() * 14ms);
    }

    .legend {
      animation-delay: 420ms;
    }

    .screen[data-on] :is(.readout, .week, .day, .legend) {
      animation-play-state: running;
    }
  }
</style>
