---
interface Props {
  jp: string;
  title: string;
  id?: string;
}

const { jp, title, id } = Astro.props;
---

<section id={id}>
  <h2>
    <span class="dot jp" lang="ja">{jp}</span>
    <span class="label">{title}</span>
    <slot name="hint" />
  </h2>
  <slot />
</section>

<style>
  section {
    margin-top: 96px;
  }

  h2 {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 20px;
    font-weight: 400;
  }

  h2 > :global(.hint) {
    justify-items: end;
    margin-left: auto;
  }

  .jp {
    font-size: 15px;
    color: var(--ink);
  }
</style>
