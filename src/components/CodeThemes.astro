---
const themes = [
  { id: "sumi", name: "Sumi" },
  { id: "nezumi", name: "Nezumi" },
  { id: "champagne", name: "Champagne" },
  { id: "ai", name: "Ai" },
];
---

<nav class="codes" aria-label="Code theme">
  <span class="label name">Code</span>
  {
    themes.map(({ id, name }, index) => (
      <button class="label" type="button" data-code={id} title={`${name} (${index + 1})`}>
        {name}
      </button>
    ))
  }
  <span class="rule" aria-hidden="true"></span>
  <button class="label" type="button" data-flip>Finish</button>
</nav>

<script>
  const root = document.documentElement;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>(".codes [data-code]")];

  const show = (code: string) => {
    root.dataset.code = code;
    localStorage.setItem("code", code);

    for (const button of buttons) {
      button.setAttribute("aria-pressed", String(button.dataset.code === code));
    }
  };

  const flip = () => {
    const finish = root.dataset.finish === "silver" ? "black" : "silver";

    root.dataset.finish = finish;
    localStorage.setItem("finish", finish);
  };

  show(root.dataset.code ?? "sumi");

  for (const button of buttons) {
    button.addEventListener("click", () => show(button.dataset.code ?? "sumi"));
  }

  document.querySelector(".codes [data-flip]")?.addEventListener("click", flip);

  document.addEventListener("keydown", (event) => {
    if (event.metaKey || event.ctrlKey || event.altKey) {
      return;
    }

    const button = buttons[Number(event.key) - 1];

    if (button?.dataset.code) {
      show(button.dataset.code);
    } else if (event.key === "f") {
      flip();
    }
  });
</script>

<style>
  .codes {
    position: sticky;
    bottom: 16px;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 4px;
    width: fit-content;
    margin: 64px auto 0;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: color-mix(in oklab, var(--panel) 88%, transparent);
    box-shadow: var(--shadow);
    backdrop-filter: blur(12px);
  }

  .name {
    padding-inline: 8px 6px;
  }

  button {
    padding: 6px 9px;
    border: 1px solid transparent;
    border-radius: 5px;
    background: none;
    color: var(--ink-2);
    cursor: pointer;
    transition: color 160ms;
  }

  button[aria-pressed="true"] {
    border-color: var(--line);
    background: var(--screen);
    box-shadow: 0 1px 3px var(--screen-edge) inset;
    color: var(--seg);
    text-shadow: var(--seg-glow);
  }

  .rule {
    width: 1px;
    height: 16px;
    margin-inline: 2px;
    background: var(--line-strong);
  }

  @media (hover: hover) and (pointer: fine) {
    button:hover {
      color: var(--ink);
    }

    button[aria-pressed="true"]:hover {
      color: var(--seg);
    }
  }

  @media (width < 480px) {
    .name {
      display: none;
    }

    button {
      padding-inline: 7px;
    }
  }
</style>
