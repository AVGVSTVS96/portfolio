<button class="finish" type="button" aria-label="Switch finish between black and silver">
  <span class="label">Black</span>
  <span class="track" aria-hidden="true"><span class="knob"></span></span>
  <span class="label">Silver</span>
</button>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLElement>(".finish");
  const track = button?.querySelector<HTMLElement>(".track");

  const apply = (finish: string) => {
    root.dataset.finish = finish;
    localStorage.setItem("finish", finish);
  };

  button?.addEventListener("click", async () => {
    const finish = root.dataset.finish === "silver" ? "black" : "silver";

    if (!track || !("ViewTransition" in window && "types" in ViewTransition.prototype)) {
      apply(finish);

      return;
    }

    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.startViewTransition(() => apply(finish));

      return;
    }

    const { left, top, width, height } = track.getBoundingClientRect();
    const x = left + width / 2;
    const y = top + height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    const transition = document.startViewTransition({ update: () => apply(finish), types: ["reveal"] });

    try {
      await transition.ready;
    } catch {
      return;
    }

    root.animate(
      { clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
      { duration: 500, easing: "cubic-bezier(0.32, 0.72, 0, 1)", pseudoElement: "::view-transition-new(root)" },
    );
  });
</script>

<style>
  .finish {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .track {
    position: relative;
    width: 30px;
    height: 14px;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    background: var(--screen);
    box-shadow: 0 1px 3px var(--screen-edge) inset;
  }

  .knob {
    position: absolute;
    top: 1px;
    left: 1px;
    width: 14px;
    height: 10px;
    border-radius: 1px;
    background: linear-gradient(var(--sheen), var(--panel));
    box-shadow:
      0 1px 0 var(--edge) inset,
      0 1px 2px rgb(0 0 0 / 0.5);
    transition: translate 220ms var(--ease-out);
  }

  .knob::after {
    position: absolute;
    inset: 3px 6px;
    content: "";
    border-inline: 1px solid var(--line-strong);
  }

  .finish:active .knob {
    translate: 3px 0;
  }

  :root[data-finish="silver"] .knob {
    translate: 12px 0;
  }

  :root[data-finish="silver"] .finish:active .knob {
    translate: 9px 0;
  }

  .label {
    transition: color 220ms;
  }

  :root:not([data-finish="silver"]) .label:first-child,
  :root[data-finish="silver"] .label:last-child {
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .knob {
      transition: none;
    }
  }
</style>
