{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "bun install --frozen-lockfile --ignore-scripts",
  "redirects": [
    { "source": "/blog", "destination": "/#writing" },
    { "source": "/blog/", "destination": "/#writing" },
    { "source": "/about", "destination": "/" },
    { "source": "/about/", "destination": "/" }
  ]
}
